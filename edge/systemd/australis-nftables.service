[Unit]
Description=Australis edge nftables ruleset (blocklist sets)
Before=australis-agent.service
Wants=network-pre.target
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/australis/australis.nft
ExecReload=/usr/sbin/nft -f /etc/australis/australis.nft

[Install]
WantedBy=multi-user.target

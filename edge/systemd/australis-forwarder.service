[Unit]
Description=Australis edge TCP forwarder (hides origin, adds PROXY protocol)
After=network-online.target australis-nftables.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/australis/forwarder.env
# LISTEN, ORIGIN, MAX_CONNS, MAX_CONNS_PER_IP, IDLE_TIMEOUT are set in the env
# file (install-edge.sh always writes them). METRICS is optional: the binary
# reads it from the environment as the default for -metrics, so an empty METRICS
# leaves the endpoint disabled without needing a flag here.
ExecStart=/opt/australis/forwarder -listen ${LISTEN} -origin ${ORIGIN} -proxy-protocol -max-conns ${MAX_CONNS} -max-conns-per-ip ${MAX_CONNS_PER_IP} -idle-timeout ${IDLE_TIMEOUT}
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target

#!/usr/sbin/nft -f
#
# Australis edge nftables ruleset.
# Defines the blocklist sets that the australis-agent feeds, and drops any
# traffic from a blocklisted source. Timeouts mean bans expire automatically.
#
# Load with:  sudo nft -f /etc/australis/australis.nft
# Inspect:    sudo nft list table inet australis
#
# This is the L3/L4 *enforcement* target for the feedback loop. Protocol-level
# line-rate filtering (SYN floods, bad VarInts, invalid MC packets) is the XDP
# program's job — see edge/xdp/README.md. The two compose: XDP throws away junk
# at the NIC; this set drops the specific IPs the plugin has convicted.

# The public game port. install-edge.sh rewrites this to match LISTEN's port.
define GAME_PORT = 25565

table inet australis {
    set blocklist {
        type ipv4_addr
        flags timeout
        comment "IPv4 sources convicted by the Australis plugin"
    }

    set blocklist6 {
        type ipv6_addr
        flags timeout
        comment "IPv6 sources convicted by the Australis plugin"
    }

    chain input {
        # priority -150 runs this before the normal filter chains.
        # policy accept so this table only ever *adds* drops — it never takes over
        # the box's firewall or blocks anything it doesn't explicitly match.
        type filter hook input priority -150; policy accept;

        # Never touch already-open flows or loopback — this is what keeps an
        # admin's existing SSH session and local services alive under attack.
        ct state established,related accept
        iif "lo" accept

        # Drop convicted sources outright (all ports — they are attackers).
        ip  saddr @blocklist  drop
        ip6 saddr @blocklist6 drop

        # Fallback SYN/new-connection rate-limit — PER SOURCE IP and scoped to the
        # game port only, so one attacker can't exhaust a shared budget and lock
        # out SSH or other sources. This is a coarse safety net for boxes without
        # the XDP filter; XDP does this far more efficiently and precisely.
        tcp dport $GAME_PORT ct state new \
            meter au_syn4 { ip  saddr limit rate over 40/second burst 60 packets } drop
        tcp dport $GAME_PORT ct state new \
            meter au_syn6 { ip6 saddr limit rate over 40/second burst 60 packets } drop
    }
}
